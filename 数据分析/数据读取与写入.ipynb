   "source": [
    "import pandas as pd\n",
    "\n",
    "# 读取数据\n",
    "data = pd.read_csv('data/sales.csv', usecols = ['订单号', '产品类别', '产品名称', '销售数量', '单价'])   # usecols 指定读取的列\n",
    "data\n",
    "\n",
    "# 数据处理\n",
    "data['销售金额'] = data['销售数量'] * data['单价']\n",
    "data\n",
    "\n",
    "# 写入数据\n",
    "data.to_csv('data/sales_result.csv', index = False)  # index = False 表示不写入索引列\n",
    "\n"
   ],
